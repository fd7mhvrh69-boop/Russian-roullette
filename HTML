<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Chamber</title>
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }
        body, html {
            width: 100%;
            height: 100%;
            overflow: hidden;
            background-color: #080808;
            display: flex;
            justify-content: center;
            align-items: center;
            cursor: pointer;
            user-select: none;
            transition: background-color 0.08s ease;
        }
        /* Heavy, matte gunmetal steel cylinder block */
        .cylinder-container {
            width: 92vmin;
            height: 92vmin;
            position: relative;
            border-radius: 50%;
            background: radial-gradient(circle, #2a2c2e 10%, #1c1d1f 70%, #0d0e0f 100%);
            border: 12px solid #252729;
            box-shadow: inset 0 0 40px #000, 0 25px 60px rgba(0,0,0,0.9);
            transition: transform 0.5s cubic-bezier(0.15, 0.85, 0.35, 1);
        }
        /* Center axis pin */
        .center-pin {
            position: absolute;
            top: 50%;
            left: 50%;
            width: 16%;
            height: 16%;
            background: radial-gradient(circle, #3a3d40, #111214);
            border-radius: 50%;
            transform: translate(-50%, -50%);
            border: 6px solid #0d0e0f;
            box-shadow: 0 4px 10px rgba(0,0,0,0.5);
            z-index: 10;
        }
        /* Deep bored-out chambers */
        .chamber {
            position: absolute;
            width: 23%;
            height: 23%;
            border-radius: 50%;
            background: #030303;
            box-shadow: inset 0 8px 16px rgba(0,0,0,0.9), inset 0 2px 4px rgba(0,0,0,0.9);
            border: 3px solid #1f2122;
            top: 50%;
            left: 50%;
            transform-origin: 0 0;
        }
        /* Mathematical physical alignment of the 6 chambers */
        .chamber:nth-child(1) { transform: translate(-50%, -50%) rotate(0deg) translateY(-138%); }
        .chamber:nth-child(2) { transform: translate(-50%, -50%) rotate(60deg) translateY(-138%); }
        .chamber:nth-child(3) { transform: translate(-50%, -50%) rotate(120deg) translateY(-138%); }
        .chamber:nth-child(4) { transform: translate(-50%, -50%) rotate(180deg) translateY(-138%); }
        .chamber:nth-child(5) { transform: translate(-50%, -50%) rotate(240deg) translateY(-138%); }
        .chamber:nth-child(6) { transform: translate(-50%, -50%) rotate(300deg) translateY(-138%); }

        /* Muted brass case coloring - no bright yellow */
        .chamber.loaded {
            background: radial-gradient(circle, #8a7322 20%, #5e4e17 60%, #1a1504 95%);
            border-color: #3b3519;
            box-shadow: inset 0 2px 5px rgba(255,255,255,0.1);
        }
        /* Fired/spent dark void trace */
        .chamber.spent {
            background: #010101;
            box-shadow: inset 0 10px 20px #000;
            border-color: #111;
        }
        /* Immediate firing screen flash */
        body.flash {
            background-color: #7a1515;
        }
    </style>
</head>
<body>

    <div class="cylinder-container" id="cylinder">
        <div class="center-pin"></div>
        <div class="chamber"></div>
        <div class="chamber"></div>
        <div class="chamber"></div>
        <div class="chamber"></div>
        <div class="chamber"></div>
        <div class="chamber"></div>
    </div>

    <script>
        const cylinder = document.getElementById('cylinder');
        const chambers = document.querySelectorAll('.chamber');
        
        let totalChambers = 6;
        let bulletIndex = 0;
        let currentChamber = 0;
        let isSpinning = false;
        let rotationDegrees = 0;

        function initGame() {
            bulletIndex = Math.floor(Math.random() * totalChambers);
            currentChamber = 0;
            
            chambers.forEach((chamber, index) => {
                chamber.classList.remove('loaded', 'spent');
                // Optional line for testing/debugging:
                // if (index === bulletIndex) chamber.classList.add('loaded');
            });
        }

        function pullTrigger() {
            if (isSpinning) return;

            if (currentChamber === bulletIndex) {
                document.body.classList.add('flash');
                chambers[currentChamber].classList.add('spent');
                isSpinning = true;

                setTimeout(() => {
                    document.body.classList.remove('flash');
                    initGame();
                    isSpinning = false;
                }, 350);
            } else {
                chambers[currentChamber].classList.add('spent');
                currentChamber = (currentChamber + 1) % totalChambers;
                rotationDegrees += 60;
                cylinder.style.transform = `rotate(${rotationDegrees}deg)`;
            }
        }

        window.addEventListener('click', () => {
            pullTrigger();
        });

        initGame();
    </script>
</body>
</html>
